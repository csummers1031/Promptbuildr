{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptbuildr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Custom domain — LIVE. Serves the production domain in addition to the
  // *.workers.dev URL. Requires promptbuildr.ai to be a zone on this
  // Cloudflare account (nameservers pointed to Cloudflare).
  "routes": [{ "pattern": "promptbuildr.ai", "custom_domain": true }],
  // Workers KV for the Next.js incremental (ISR) cache.
  // Create with: npx wrangler kv namespace create NEXT_INC_CACHE_KV
  // then paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "b2c3f79ce93845c9aa7aa549fa27ce31"
    }
  ]
  // Secrets (ANTHROPIC_API_KEY, DATABASE_URL, CRON_SECRET, INDEXNOW_KEY,
  // HUBSPOT_ACCESS_TOKEN, SESSION_SECRET) are set with:
  //   npx wrangler secret put <NAME>
  // Public vars (NEXT_PUBLIC_*) go in a [vars] block or the build env.
}
