{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptbuildr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Per-request CPU ceiling (safety net against a runaway request racking up
  // cost). 1000ms is ~2x the heaviest legit render and 100x the old free-tier
  // 10ms cap that was erroring, so normal traffic is unaffected.
  "limits": {
    "cpu_ms": 1000
  },
  // Custom domains — LIVE. Serves the apex and www in addition to the
  // *.workers.dev URL. Attaching www as a custom domain auto-creates its
  // DNS record + cert (covered by the *.promptbuildr.ai wildcard). Requires
  // promptbuildr.ai to be a zone on this Cloudflare account.
  "routes": [
    { "pattern": "promptbuildr.ai", "custom_domain": true },
    { "pattern": "www.promptbuildr.ai", "custom_domain": true }
  ],
  // Workers KV for the Next.js incremental (ISR) cache.
  // Create with: npx wrangler kv namespace create NEXT_INC_CACHE_KV
  // then paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "b2c3f79ce93845c9aa7aa549fa27ce31"
    }
  ],
  // Self-reference so the OpenNext memory queue can call back into this Worker
  // to regenerate ISR pages (required by the queue override in open-next.config.ts).
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "promptbuildr" }
  ]
  // Secrets (ANTHROPIC_API_KEY, DATABASE_URL, CRON_SECRET, INDEXNOW_KEY,
  // HUBSPOT_ACCESS_TOKEN, SESSION_SECRET) are set with:
  //   npx wrangler secret put <NAME>
  // Public vars (NEXT_PUBLIC_*) go in a [vars] block or the build env.
}
